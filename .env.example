# UNIKLIFE.AI — Environment Variables Template
# Copy to .env and fill with real values. NEVER commit .env

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App
VITE_APP_NAME=UNIKLIFE.AI
VITE_APP_ENV=development

# Uniklife CRM — Webhook integration (login.uniklife.ai)
# CRM_WEBHOOK_SECRET = Webhooks API key from login.uniklife.ai → Settings → API → Webhooks API
#                      Set as a Supabase secret (NOT a VITE_ var — server-side only):
#                      supabase secrets set CRM_WEBHOOK_SECRET=<key>
# VITE_CRM_SUB_ACCOUNT_ID = your sub-account UUID (from URL: /v2/s/{this-id}/...)
#                            Also run this SQL once after migration:
#                            UPDATE tenants SET crm_location_id = '<this-id>' WHERE slug = 'your-tenant-slug';
VITE_CRM_SUB_ACCOUNT_ID=PASTE_SUB_ACCOUNT_ID_HERE
